# Copy to .env and fill in before running any deploy/CLI commands.

# LLM provider key(s) used by validator nodes you operate locally (Localnet/GLSim only --
# hosted Studionet/Bradbury validators use their own configured providers).
OPENAI_API_KEY=

# Network selection -- see docs/03-architecture.md for the endpoint table.
GENLAYER_NETWORK=studionet

# Set after `genlayer deploy` -- keep this out of version control once populated with a
# real mainnet-adjacent address; Studionet/testnet addresses are fine to commit for demos.
DOCKET_CONTRACT_ADDRESS=
